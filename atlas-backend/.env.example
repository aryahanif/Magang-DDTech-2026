# Atlas Backend Environment Variables
# Copy this file to .env and fill in the values

# ====================
# Server
# ====================
PORT=3000
NODE_ENV=development

# ====================
# Database (PostgreSQL)
# ====================
DATABASE_URL=postgresql://user:password@localhost:5432/atlas_db

# ====================
# Security
# ====================
JWT_SECRET=your_super_secure_jwt_secret_here
JWT_EXPIRES_IN=1d

# ====================
# Email (Mailtrap API)
# Note: Using Mailtrap API, not SMTP
# ====================
MAILTRAP_API_TOKEN=your_mailtrap_api_token_here
SALES_TEAM_EMAIL=sales@your-company.com
EMAIL_FROM=onboarding@atlas.dev
ADMIN_DASHBOARD_URL=http://localhost:3000

# ====================
# Bot Protection (Cloudflare Turnstile)
# Required for public lead submission form
# ====================
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_here

# ====================
# AI Integration — Primary (Google Gemini)
# ====================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ====================
# AI Integration — Fallback 1 (Groq)
# ====================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ====================
# AI Integration — Fallback 2 (Local Ollama)
# ====================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ====================
# Google OAuth Integration (optional)
# Required for Google Calendar / Gmail integration
# ====================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
FRONTEND_URL=http://localhost:5173
