generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id                      String    @id @default(uuid()) @db.Uuid
  full_name               String?
  email                   String
  phone                   String?
  company_name            String?
  country                 String?
  business_type           String?
  industry                String?
  role                    String?
  website_url             String?
  company_size            String?
  current_problem         String?
  automation_interest     String?
  preferred_contact_method String?
  message                 String?
  source_page             String?
  utm_source              String?
  utm_medium              String?
  utm_campaign            String?
  consent_status          Boolean?
  consent_at              DateTime?
  
  lead_score              Int?
  lead_tier               String?
  fit_status              String?
  qualification_summary   String?
  recommended_next_action String?
  urgency_level           String?
  
  status                  String?   @default("New Lead")
  assigned_owner          String?
  next_follow_up_at       DateTime?
  
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  notes                   LeadNote[]
  activity_logs           LeadActivityLog[]

  @@map("leads")
}

model LeadNote {
  id         String   @id @default(uuid()) @db.Uuid
  lead_id    String   @db.Uuid
  note       String?
  created_by String?
  created_at DateTime @default(now())

  lead       Lead     @relation(fields: [lead_id], references: [id])

  @@map("lead_notes")
}

model LeadActivityLog {
  id            String   @id @default(uuid()) @db.Uuid
  lead_id       String   @db.Uuid
  activity_type String?
  description   String?
  metadata      Json?
  created_at    DateTime @default(now())

  lead          Lead     @relation(fields: [lead_id], references: [id])

  @@map("lead_activity_logs")
}

model User {
  google_access_token String?
  google_refresh_token String?
  email_signature     String?
  id            String   @id @default(uuid()) @db.Uuid
  name          String?
  email         String?  @unique
  role          String?
  job_title     String?
  password_hash String?
  created_at    DateTime @default(now())

  @@map("users")
}

model Task {
  id           String    @id @default(uuid()) @db.Uuid
  title        String
  due_at       DateTime
  type         String    @default("task")
  priority     String    @default("medium")
  status       String    @default("pending")
  lead_name    String?
  created_by   String?   @db.Uuid
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@map("tasks")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  message    String?
  icon       String   @default("bell")
  lead_id    String?  @db.Uuid
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("notifications")
}

model SystemSetting {
  id                         String   @id @default(uuid()) @db.Uuid
  is_ai_tiering_enabled      Boolean  @default(true)
  is_spam_detection_enabled  Boolean  @default(true)
  is_data_enrichment_enabled Boolean  @default(false)
  updated_at                 DateTime @updatedAt

  @@map("system_settings")
}